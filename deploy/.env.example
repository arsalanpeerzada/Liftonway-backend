# Copy to .env next to docker-compose.yml (never commit it) and fill in every value.

# Public name of the API, e.g. api.example.com, with its DNS pointing at this server.
DOMAIN=

# Database password: a long random value.
DB_PASSWORD=

# Token signing secret, at least 32 random bytes. Generate one with:  openssl rand -base64 48
LIFTONWAY_JWT_SECRET=

# Twilio: an API key (not the auth token) and a Messaging Service, from the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
# Or, instead of a Messaging Service, a single sending number in E.164 format.
TWILIO_FROM=
